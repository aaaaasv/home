# from @BotFather
TELEGRAM_BOT_TOKEN=
# telegram user ids allowed to talk to the bot, comma separated — everyone else is ignored.
# leave empty on first run: the bot logs the id of everyone it ignores, so you can read yours off the logs
TELEGRAM_ALLOWED_USER_IDS=
# chat the daily digest is sent to (the home group); negative id for groups
TELEGRAM_REMINDER_CHAT_ID=
# topic titles are only used when the bot creates a topic it does not yet know about — name them
# whatever your household actually calls them. the defaults below are deliberately plain
# the group must be a forum (topics enabled) — a module without a topic answers nothing.
# leave empty: the bot creates its own topic and remembers it in the database.
# set it only to adopt a topic you made by hand — run /chatid inside that topic to read the id
TELEGRAM_PLANTS_TOPIC_ID=
PLANTS_TOPIC_TITLE=plants
TELEGRAM_SHOPPING_TOPIC_ID=
SHOPPING_TOPIC_TITLE=shopping
TELEGRAM_WEATHER_TOPIC_ID=
WEATHER_TOPIC_TITLE=climate
TELEGRAM_CHORES_TOPIC_ID=
CHORES_TOPIC_TITLE=chores

# «справи»: a silent list of things to do — undated items never speak, but one with a deadline («до 31.07») gets a
# card that pings once it enters this lead window and is deleted the moment it is done. checked hourly, but only
# within the waking-hours window, so a crossing never pings at 03:00
CHORE_REMINDER_LEAD_DAYS=1
CHORE_REMINDER_START_HOUR=9
CHORE_REMINDER_END_HOUR=21

# in docker these are overridden by docker-compose.yml to live under the ./data volume
DATABASE_PATH=home.db
PHOTO_STORAGE_PATH=photos

# what the bot signs itself as when it annotates something. plain by default on purpose —
# name it whatever your household calls it
BOT_DISPLAY_NAME=bot

TIMEZONE=Europe/Kyiv
DAILY_DIGEST_TIME=09:00
# saturdays and sundays get a later one — same digest, different hour. leave empty for "same as weekdays"
WEEKEND_DIGEST_TIME=11:00
RECENT_CARE_GUARD_HOURS=12

# the SHT31 sensor on the pi's i2c bus. leave disabled until the sensor is physically wired in:
# enabling it also requires /dev/i2c-1 passed into the container (see docker-compose.yml)
CLIMATE_SENSOR_ENABLED=false
CLIMATE_SENSOR_I2C_BUS=1
CLIMATE_SENSOR_I2C_ADDRESS=68
CLIMATE_SAMPLE_INTERVAL_SECONDS=60
# a plant alerts only when the median over this window crosses its ideal range — a heated flat is dry all winter,
# so a level check would fire every day and get the group muted. each uncomfortable plant then keeps one standing
# card that is deleted the moment it is comfortable again, so the bot speaks only on a change, never on a repeat
CLIMATE_ALERT_WINDOW_HOURS=24
CLIMATE_HYSTERESIS_TEMPERATURE_CELSIUS=1
CLIMATE_HYSTERESIS_HUMIDITY_PERCENT=3

# the daily weather digest (Open-Meteo, no api key) lives in its own topic so its always-on chatter can be muted
# without silencing the plant alerts
WEATHER_DIGEST_ENABLED=false
WEATHER_DIGEST_TIME=08:00
# after the morning post the digest refreshes itself in place (silent edit) every N minutes, only within this
# inclusive hour range — a glance at the topic then shows the state now, with a "станом на HH:MM" footer
WEATHER_REFRESH_MINUTES=15
WEATHER_REFRESH_START_HOUR=8
WEATHER_REFRESH_END_HOUR=22
WEATHER_LATITUDE=50.45
WEATHER_LONGITUDE=30.52

# the raspberry pi's own vitals (temperature, under-voltage, disk) posted to a technical topic only when wrong
SYSTEM_HEALTH_ENABLED=false
TELEGRAM_TECH_TOPIC_ID=
TECH_TOPIC_TITLE=service
PI_TEMPERATURE_ALERT_CELSIUS=75
PI_DISK_ALERT_PERCENT=90
PI_HEALTH_CHECK_MINUTES=10

# presence: reads who is on Wi-Fi from the router's local api to catch "everyone left, ac still on"
PRESENCE_ENABLED=false
# the documentation range from RFC 5737 — put your own router's address here
ROUTER_HOST=192.0.2.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=
PRESENCE_PHONE_MACS=
PRESENCE_CHECK_MINUTES=3
PRESENCE_AWAY_GRACE_MINUTES=15

# the gree-protocol air conditioner. give it a fixed dhcp lease on the router so the address holds,
# and read the mac off the router's client list (no colons)
AIR_CONDITIONER_ENABLED=false
AIR_CONDITIONER_HOST=
AIR_CONDITIONER_MAC=
AIR_CONDITIONER_ROOM=вітальня
AIR_CONDITIONER_MIN_TEMPERATURE=16
AIR_CONDITIONER_MAX_TEMPERATURE=30

# /track watches a hotline.ua product and pings when it reaches a new low. it follows the cheapest
# *reputable* shop, not the cheapest full stop: a shop counts as reputable when it sells new goods and
# either clears the rating+reviews bar or sits in the trusted allowlist (comma-separated hotline firm ids)
PRICE_WATCH_TIME=07:30
HOTLINE_MINIMUM_RATING=80
HOTLINE_MINIMUM_REVIEWS=100
# hand-trusted hotline firm ids, always reputable even below the bar. default = big national chains that
# sit under 80: 862 ALLO, 287 STYLUS, 32066 Vodafone, 2248 Citrus, 11054 MOYO, 1531 ELMIR, 3300 ITbox
HOTLINE_TRUSTED_FIRM_IDS=862,287,32066,2248,11054,1531,3300
# prices are read from hotline's graphql api; it needs a token minted by any live product page, lifted from the
# first product under this evergreen category. city 187 = kyiv (the price list is per-city)
HOTLINE_DONOR_CATEGORY_URL=https://hotline.ua/ua/computer/noutbuki/
HOTLINE_CITY_ID=187

# every new plant photo is compared with the previous one by claude, roughly $2 a year at this volume.
# needs a key from console.anthropic.com; with no key the upload just saves the photo as before
PLANT_PHOTO_REVIEW_ENABLED=false
ANTHROPIC_API_KEY=
PLANT_PHOTO_REVIEW_MODEL=claude-opus-4-8

# names an unfamiliar plant from the photo sent while adding it, so the species and the watering rhythm are
# confirmed with one tap rather than typed. shares GEMINI_API_KEY and its free-tier quota with the assistant;
# off, or without a key, the flow simply asks for the species as it always did
PLANT_IDENTIFICATION_ENABLED=false

# transit: an on-demand "when is the next one" card for a configured stop, from a public GTFS-realtime feed
# (no api key). off by default; the stop, routes and endpoints below have no defaults — set them for your own stop
# TRANSIT_ROUTES ("route_id:short_name:kind,…") and the stop coords to watch a different stop
TRANSIT_ENABLED=false
TELEGRAM_TRANSIT_TOPIC_ID=
TRANSIT_TOPIC_TITLE=transit

LOG_LEVEL=INFO

# ── power: EcoFlow Delta 2 over local BLE, no cloud, no vendor app ────────────
ECOFLOW_ENABLED=false
TELEGRAM_POWER_TOPIC_ID=
POWER_TOPIC_TITLE=power
# the station's bluetooth mac and the ecoflow account the unit is registered to
ECOFLOW_BLE_MAC=
ECOFLOW_USER_ID=
ECOFLOW_BLE_SCAN_SECONDS=20
ECOFLOW_POLL_MINUTES=10
# a lithium pack left full degrades; "conserved" means parked at storage charge.
# the poll only trusts a reading once the station has been settled this long, so a
# restart caught mid-reconnect cannot falsely trip it
ECOFLOW_CONSERVED_AFTER_MINUTES=20
ECOFLOW_CONSERVATION_CHECK_HOURS=4

# ── yasno planned-outage schedule — silent when nothing is planned ────────────
YASNO_ENABLED=false
# the group, region and distribution operator identify one address's supply.
# read them off yasno.com.ua for your own address; there is no sensible default
YASNO_GROUP=
YASNO_REGION_ID=
YASNO_DSO_ID=
YASNO_DIGEST_TIME=08:30
# emergency outages get added mid-day, so re-read often — keep under the lead below
YASNO_POLL_MINUTES=20
YASNO_PRE_OUTAGE_LEAD_MINUTES=30

# ── assistant: grounded Q&A over a curated knowledge file ────────────────────
# the free Gemini tier trains on inputs and humans may read them —
# keep NO secrets in the knowledge file
ASSISTANT_ENABLED=false
TELEGRAM_ASSISTANT_TOPIC_ID=
ASSISTANT_TOPIC_TITLE=ask
ASSISTANT_KNOWLEDGE_PATH=home-knowledge.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── places ───────────────────────────────────────────────────────────────────
TELEGRAM_PLACES_TOPIC_ID=
PLACES_TOPIC_TITLE=places

# ── transit: the stop, the routes, the direction ──────────────────────────────
# no defaults: a stop id and its coordinates name the street somebody lives on.
# TRANSIT_ROUTES is "route_id:short_name:kind", comma separated (trolleybus|bus|tram)
TRANSIT_STOP_ID=
TRANSIT_STOP_LATITUDE=
TRANSIT_STOP_LONGITUDE=
# a point every watched route heads toward — it picks each route's correct
# direction, because the sparse stop_times cannot give direction on their own
TRANSIT_DESTINATION_LATITUDE=
TRANSIT_DESTINATION_LONGITUDE=
TRANSIT_ROUTES=
TRANSIT_REALTIME_URL=
TRANSIT_STATIC_URL=
TRANSIT_STATIC_CACHE_PATH=gtfs-static
TRANSIT_STATIC_REFRESH_DAYS=7
# the card re-estimates this often, for this long, then freezes
TRANSIT_CARD_REFRESH_SECONDS=30
TRANSIT_CARD_WINDOW_MINUTES=10

# ── thresholds that recover before the alert clears (hysteresis) ──────────────
PI_TEMPERATURE_RECOVERY_CELSIUS=70
PI_DISK_RECOVERY_PERCENT=85
AIR_CONDITIONER_CHECK_MINUTES=15
AIR_CONDITIONER_LONG_RUN_HOURS=6
DIGEST_CHECK_INTERVAL_MINUTES=5

# ── plant sheets in a browser (the pages NFC tags on the pots point at) ───────
# the mqtt broker: how homebridge (and later zigbee2mqtt) reach the house. the bot publishes the air
# conditioner as a thermostat and accepts taps back. host is the compose service name from inside the
# container; leave the credentials empty while the broker only listens on loopback and the compose network
MQTT_ENABLED=false
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=home-bot
MQTT_PUBLISH_INTERVAL_SECONDS=30

WEB_ENABLED=false
# the port inside the container; the bot binds this one
WEB_PORT=8080
# the port on the host, and so the one guests type — 80 gives a bare hostname with no ":port",
# but only if nothing else already holds it (a pi-hole or any other admin page usually does)
WEB_HOST_PORT=8080
# who the sheet credits when care is recorded from the page rather than from telegram
WEB_ACTOR_NAME=

# which published image this machine runs, and which tag of it. set by `make deploy`, which writes the
# sha-pinned tag so the answer to "what is running" cannot drift from what was built
BOT_IMAGE=ghcr.io/aaaaasv/home-bot
BOT_VERSION=0.1.0
